{
  "name": "izimza-frontend-case",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "browser-tabs-lock": false,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260826.1": true
  },
  "scripts": {
    "dev": "vite",
    "api": "node mock/server.cjs",
    "build": "npm run check && vite build",
    "build-storybook": "storybook build",
    "check": "npm run format:check && npm run lint && npm run type-check",
    "format": "prettier . --write && eslint . --fix",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run --reporter=verbose",
    "type-check": "vue-tsc --noEmit",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:migrate:local": "wrangler d1 migrations apply DATABASE --local --config worker/wrangler.jsonc",
    "worker:type-check": "tsc --project worker/tsconfig.json --noEmit",
    "worker:types": "wrangler types worker/worker-configuration.d.ts --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@auth0/auth0-vue": "^2.9.0",
    "axios": "^1.19.0",
    "jose": "^6.2.10",
    "pinia": "^3.0.4",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.10",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/vue3-vite": "^10.5.10",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "2.5.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "happy-dom": "20.11.12",
    "husky": "9.1.7",
    "json-server": "^0.17.4",
    "multer": "^2.2.0",
    "prettier": "3.9.6",
    "storybook": "^10.5.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "^6.4.3",
    "vitest": "4.1.11",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.126.0"
  }
}
